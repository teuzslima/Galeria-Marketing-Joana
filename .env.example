# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API)

# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Chave pública (anon). Segura para o navegador — o acesso é protegido pelo RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave service_role. NUNCA exponha no navegador! Usada apenas nas rotas de API
# (geração de Signed URLs e do ZIP).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL pública do site (usada para montar os links das galerias no painel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

